# Server Configuration
PORT=5001
NODE_ENV=development
API_BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slotmyinterview?schema=public"

# Redis (Caching, Rate Limiting, BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_jwt_access_key_slotmyinterview_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_slotmyinterview_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Service (Resend or SendGrid)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_test_dummy_key
SENDGRID_API_KEY=
FROM_EMAIL=notifications@slotmyinterview.com

# Cloud Storage (S3 / Cloudinary / Local)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=slotmyinterview-media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth Provider Credentials (GitHub, Google, LinkedIn)
GITHUB_CLIENT_ID=mock_github_client_id
GITHUB_CLIENT_SECRET=mock_github_client_secret
GOOGLE_CLIENT_ID=mock_google_client_id
GOOGLE_CLIENT_SECRET=mock_google_client_secret
LINKEDIN_CLIENT_ID=mock_linkedin_client_id
LINKEDIN_CLIENT_SECRET=mock_linkedin_client_secret

# GitHub API Token (For seeker repository quality and commit scoring analysis)
GITHUB_API_TOKEN=

